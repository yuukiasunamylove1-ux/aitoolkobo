---
import Base from "../layouts/Base.astro";
import Shell from "../components/Shell.astro";
import { absoluteUrl } from "../lib/labels";
import { pageGraph } from "../lib/seo";

const description = "AIツール工房への連絡用ページです。フォームはまだ送信先に接続していません。";
const jsonLd = pageGraph({
  site: Astro.site!.href,
  url: absoluteUrl("/contact/", Astro.site!),
  name: "お問い合わせ",
  description,
});
---

<Base title="お問い合わせ" description={description} jsonLd={jsonLd}>
  <Shell mode="plain">
    <section>
      <h1>お問い合わせ</h1>
      <p class="lede">
        このフォームはまだ送信先に接続していません。入力してもメールは残りません。
      </p>
      <form class="newsletter" action="" method="post">
        <label for="contact-name">名前</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" />
        <label for="contact-email">メールアドレス</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" />
        <label for="contact-body">内容</label>
        <textarea id="contact-body" name="body"></textarea>
        <button class="button" type="button">送信する（未接続）</button>
      </form>
      <p class="fine">ツールの料金や仕様の訂正は、データファイルの更新で反映します。手順は README にあります。</p>
    </section>
  </Shell>
</Base>
