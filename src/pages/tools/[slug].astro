---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScoreTable from "../../components/ScoreTable.astro";
import ToolLogo from "../../components/ToolLogo.astro";
import ToolRow from "../../components/ToolRow.astro";
import { FX_NOTE, JA_MARK, JA_WORD, priceView, testedValue } from "../../lib/display";
import { TIER_LABEL, absoluteUrl, formatDate } from "../../lib/labels";
import { toolsInCategory } from "../../lib/queries";
import { breakdownFor } from "../../lib/score";
import { pageGraph } from "../../lib/seo";
import type { SupportLevel } from "../../lib/schema";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({ params: { slug: tool.id } }));
}

const { slug } = Astro.params;
const tool = await getEntry("tools", slug);
if (!tool) throw new Error(`unknown tool ${slug}`);
const category = await getEntry("categories", tool.data.category);
if (!category) throw new Error(`unknown category ${tool.data.category}`);

const score = breakdownFor(tool.data);
const price = priceView(tool.data.pricing);
const site = Astro.site!;
const url = absoluteUrl(`/tools/${tool.id}/`, site);
const peers = (await toolsInCategory(category.id)).filter((row) => row.tool.id !== tool.id).slice(0, 5);
const levels = [
  { key: "ui" as const, label: "UI" },
  { key: "input" as const, label: "入力" },
  { key: "output" as const, label: "出力" },
];

const software: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.data.name,
  description: tool.data.description,
  url: tool.data.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: tool.data.platforms.join(", "),
};
if (tool.data.pricing.monthlyAmount != null && tool.data.pricing.currency) {
  software.offers = {
    "@type": "Offer",
    price: String(tool.data.pricing.monthlyAmount),
    priceCurrency: tool.data.pricing.currency,
    url: tool.data.pricing.sourceUrl,
  };
}

const jsonLd = [
  pageGraph({ site: site.href, url, name: tool.data.name, description: tool.data.description }),
  software,
];
---

<Base title={tool.data.name} description={tool.data.description} jsonLd={jsonLd}>
  <article class="page">
    <div class="wrap">
      <Breadcrumb
        items={[
          { name: "ホーム", href: "/" },
          { name: category.data.name, href: `/categories/${category.id}/` },
          { name: tool.data.name, href: `/tools/${tool.id}/` },
        ]}
      />
      <header class="tool-head">
        <div class="tool-id">
          <ToolLogo slug={tool.id} name={tool.data.name} size={48} />
          <div>
            <h1>{tool.data.name}</h1>
            <p>{category.data.name} · {tool.data.platforms.join(" · ")}</p>
              <p class="note">
                確認日 {formatDate(tool.data.lastChecked)}
                {tool.data.checks.filter((check) => check.kind === "official").length === 0
                  ? " · 公式の断定できる記載はありません。"
                  : tool.data.checks
                      .filter((check) => check.kind === "official" && check.sourceUrl)
                      .map((check) => (
                        <>
                          {" · 公式 "}
                          <a href={check.sourceUrl}>
                            {check.field === "ui"
                              ? "日本語UI"
                              : check.field === "input"
                                ? "日本語入力"
                                : check.field === "output"
                                  ? "日本語出力"
                                  : check.field === "pricing"
                                    ? "料金"
                                    : "商用"}
                          </a>
                        </>
                      ))}
              </p>
              {tool.data.checks.some((check) => check.kind === "tested") && (
                <p class="note">
                  実測
                  {tool.data.checks
                    .filter((check) => check.kind === "tested")
                    .map((check) => (
                      <>
                        {" · "}
                        {check.field === "ui" ? "日本語UI" : check.field === "input" ? "日本語入力" : "日本語出力"}
                        {check.value === "supported" ? "対応" : check.value === "partial" ? "一部" : check.value === "unsupported" ? "非対応" : ""}
                        （{check.method}
                        {check.sourceUrl ? <a href={check.sourceUrl}>出典</a> : check.command}）
                      </>
                    ))}
                </p>
              )}
          </div>
        </div>
        <a class="out" href={tool.data.url}>公式サイト ↗</a>
      </header>

      <div class="tool-layout">
        <div>
          <p>{tool.data.detail}</p>
          <ScoreTable score={score} />

          <table class="data">
            <caption>料金</caption>
            <thead>
              <tr>
                <th>区分</th>
                <th>月額</th>
                <th>円の目安</th>
                <th>備考</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{TIER_LABEL[tool.data.pricing.tier]}</td>
                <td class="num">
                  {tool.data.pricing.monthlyAmount != null && tool.data.pricing.currency
                    ? `${tool.data.pricing.currency === "USD" ? "$" : tool.data.pricing.currency === "EUR" ? "€" : "¥"}${tool.data.pricing.monthlyAmount}`
                    : "—"}
                </td>
                <td class="num" title={price.title}>{price.yenText}</td>
                <td>{tool.data.pricing.short}</td>
              </tr>
            </tbody>
          </table>
          <p class="note">{FX_NOTE} 出典: <a href={tool.data.pricing.sourceUrl}>料金の参照元</a></p>

          <h2>編集部メモ</h2>
          <ul>
            <li>機能：{tool.data.editorial.features.note}</li>
            <li>使いやすさ：{tool.data.editorial.usability.note}</li>
            <li>更新頻度：{tool.data.editorial.updates.note}</li>
          </ul>
          <h2>参照</h2>
          <ul>
            {tool.data.sources.map((source) => (
              <li><a href={source.url}>{source.label}</a>（確認日 {formatDate(tool.data.lastChecked)}）</li>
            ))}
          </ul>
        </div>
        <aside class="spec">
          <h2>要点</h2>
          <dl class="spec-list">
            <dt>スコア</dt>
            <dd>{score.total.toFixed(1)} / 100</dd>
            <dt>料金</dt>
            <dd title={price.title}>{price.text}</dd>
            <dt>円換算</dt>
            <dd title={price.title}>{price.yenText}</dd>
            <dt>日本語</dt>
            <dd>
              <span class="evidence">公式</span>
              {levels.map((level) => {
                const value = tool.data.japanese[level.key] as SupportLevel;
                return (
                  <abbr class:list={["mark", value]} title={`公式 ${level.label} ${JA_WORD[value]}`}>
                    {level.label}
                    {JA_MARK[value]}
                  </abbr>
                );
              })}
              {levels.some((level) => testedValue(tool.data.checks, level.key)) && (
                <>
                  <span class="evidence">実測</span>
                  {levels.map((level) => {
                    const value = testedValue(tool.data.checks, level.key);
                    if (!value) return null;
                    return (
                      <abbr class:list={["mark", value]} title={`実測 ${level.label} ${JA_WORD[value]}`}>
                        {level.label}
                        {JA_MARK[value]}
                      </abbr>
                    );
                  })}
                </>
              )}
            </dd>
            <dt>動作</dt>
            <dd>{tool.data.platforms.join(" / ")}</dd>
            <dt>OSS</dt>
            <dd>{tool.data.pricing.tier === "open-source" ? "○" : tool.data.pricing.tier === "unknown" ? "—" : "×"}</dd>
            <dt>商用</dt>
            <dd title={tool.data.commercialNote}>
              {tool.data.commercialUse === "allowed"
                ? "可"
                : tool.data.commercialUse === "restricted"
                  ? "条件付き"
                  : tool.data.commercialUse === "not-allowed"
                    ? "不可"
                    : "—"}
            </dd>
          </dl>
          <p class="note">{tool.data.japanese.note}</p>
        </aside>
      </div>

      {peers.length > 0 && (
        <section>
          <h2>同じカテゴリ</h2>
          <ol class="tool-list">
            {peers.map((row, index) => <ToolRow row={row} rank={index + 1} />)}
          </ol>
        </section>
      )}
    </div>
  </article>
</Base>
