---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScoreTable from "../../components/ScoreTable.astro";
import { SUPPORT_LABEL, TIER_LABEL, THEMES, absoluteUrl, formatDate } from "../../lib/labels";
import { breakdownFor } from "../../lib/score";
import { pageGraph } from "../../lib/seo";
import type { SupportLevel } from "../../lib/schema";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({ params: { slug: tool.id } }));
}

const { slug } = Astro.params;
const tool = await getEntry("tools", slug);
if (!tool) throw new Error(`unknown tool ${slug}`);
const category = await getEntry("categories", tool.data.category);
if (!category) throw new Error(`unknown category ${tool.data.category}`);

const score = breakdownFor(tool.data);
const theme = THEMES[category.data.theme];
const site = Astro.site!;
const url = absoluteUrl(`/tools/${tool.id}/`, site);
const yen = tool.data.pricing.yenAmount;

const software: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.data.name,
  description: tool.data.description,
  url: tool.data.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: tool.data.platforms.join(", "),
};
if (tool.data.pricing.monthlyAmount != null && tool.data.pricing.currency) {
  software.offers = {
    "@type": "Offer",
    price: String(tool.data.pricing.monthlyAmount),
    priceCurrency: tool.data.pricing.currency,
    url: tool.data.pricing.sourceUrl,
  };
}

const levels: { key: "ui" | "input" | "output"; label: string }[] = [
  { key: "ui", label: "UI" },
  { key: "input", label: "日本語入力" },
  { key: "output", label: "日本語出力" },
];

const jsonLd = [
  pageGraph({ site: site.href, url, name: tool.data.name, description: tool.data.description }),
  software,
];
---

<Base title={tool.data.name} description={tool.data.description} jsonLd={jsonLd}>
  <article class="page-intro">
    <div class="wrap">
      <Breadcrumb
        items={[
          { name: "ホーム", href: "/" },
          { name: "カテゴリ", href: "/categories/" },
          { name: category.data.name, href: `/categories/${category.id}/` },
          { name: tool.data.name, href: `/tools/${tool.id}/` },
        ]}
      />
      <p class="kicker">{theme.name} / {category.data.name}</p>
      <h1>{tool.data.name}</h1>
      <p class="lede">{tool.data.detail}</p>
      <ul class="meta">
        {tool.data.platforms.map((platform) => <li>{platform}</li>)}
        <li>追加日 {formatDate(tool.data.addedAt)}</li>
        <li>確認日 {formatDate(tool.data.lastChecked)}</li>
      </ul>
      <p><a href={tool.data.url}>公式サイト</a></p>

      <div class="split">
        <ScoreTable score={score} />
        <div class="stack">
          <section class="panel card">
            <h2>料金</h2>
            <p><span class="pill">{TIER_LABEL[tool.data.pricing.tier]}</span></p>
            <p>{tool.data.pricing.label}</p>
            <p>
              <strong>円建て：</strong>
              {yen == null ? "未確認" : `¥${yen.toLocaleString("ja-JP")}`}
            </p>
            <p class="fine"><a href={tool.data.pricing.sourceUrl}>料金の参照元</a></p>
          </section>
          <section class="panel card">
            <h2>日本語対応</h2>
            <dl class="support-grid">
              {levels.map((level) => {
                const value = tool.data.japanese[level.key] as SupportLevel;
                return (
                  <div>
                    <dt>{level.label}</dt>
                    <dd><span class={`pill ${value}`}>{SUPPORT_LABEL[value]}</span></dd>
                  </div>
                );
              })}
            </dl>
            <p class="fine">{tool.data.japanese.note}</p>
          </section>
        </div>
      </div>

      <section class="section">
        <h2>編集部メモ</h2>
        <ul>
          <li>機能：{tool.data.editorial.features.note}</li>
          <li>使いやすさ：{tool.data.editorial.usability.note}</li>
          <li>更新頻度：{tool.data.editorial.updates.note}</li>
        </ul>
        <h2>参照</h2>
        <ul>
          {tool.data.sources.map((source) => (
            <li><a href={source.url}>{source.label}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</Base>
