---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Shell from "../../components/Shell.astro";
import ToolItem from "../../components/ToolItem.astro";
import { THEMES, absoluteUrl, formatJaDate, latestDate } from "../../lib/labels";
import { toolsInCategory } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((category) => ({ params: { slug: category.id } }));
}

const { slug } = Astro.params;
const categories = await getCollection("categories");
const category = categories.find((item) => item.id === slug);
if (!category) throw new Error(`unknown category ${slug}`);

const rows = await toolsInCategory(category.id);
const asOf = latestDate(rows.map((row) => row.tool.data.lastChecked));
const description = `${category.data.name}のランキング。${category.data.description}`;
const site = Astro.site!;
const url = absoluteUrl(`/categories/${category.id}/`, site);
const themeName = THEMES[category.data.theme].name;

const jsonLd = [
  pageGraph({ site: site.href, url, name: category.data.name, description, type: "CollectionPage" }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${category.data.name}のランキング`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: rows.length,
    itemListElement: rows.map((row, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: row.tool.data.name,
      url: absoluteUrl(`/tools/${row.tool.id}/`, site),
    })),
  },
];
---

<Base title={category.data.name} description={description} jsonLd={jsonLd}>
  <Shell mode="category" themeId={category.data.theme}>
    <Breadcrumb
      items={[
        { name: "トップ", href: "/" },
        { name: themeName, href: `/ranking/${category.data.theme}/` },
        { name: category.data.name, href: `/categories/${category.id}/` },
      ]}
    />
    <p><span class="badge-cat">{themeName}</span></p>
    <h1>{category.data.name}のおすすめ・ランキング</h1>
    <p class="lede">{category.data.description}</p>
    <p class="page-kicker"><span></span><strong>掲載 {rows.length}ツール｜{asOf ? `${formatJaDate(asOf)} 時点` : ""}</strong></p>
    <div data-catalog>
      <div class="box-tabs" role="tablist" aria-label="並び替え">
        <button type="button" data-sort="score" aria-selected="true">総合点順</button>
        <button type="button" data-sort="price" aria-selected="false">料金の安い順</button>
        <button type="button" data-sort="new" aria-selected="false">新着順</button>
      </div>
      <noscript><p class="disclaimer">並び替えにはJavaScriptを使います。オフのときは総合点順です。</p></noscript>
      <ol class="tool-list" data-tool-list>
        {rows.map((row, index) => <ToolItem row={row} rank={index + 1} />)}
      </ol>
    </div>
    <p class="disclaimer">※総合点は機能・日本語対応・価格・使いやすさ・更新頻度から算出。<a href="/scoring/">評価基準 ›</a></p>
  </Shell>
</Base>

<script>
  const root = document.querySelector("[data-catalog]");
  if (root instanceof HTMLElement) {
    const list = root.querySelector("[data-tool-list]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-sort]")];
    const apply = (mode: string) => {
      if (!(list instanceof HTMLElement)) return;
      const rows = [...list.querySelectorAll<HTMLElement>("[data-tool]")];
      rows.sort((a, b) => {
        if (mode === "price") {
          const ap = a.dataset.price === "" ? Number.POSITIVE_INFINITY : Number(a.dataset.price);
          const bp = b.dataset.price === "" ? Number.POSITIVE_INFINITY : Number(b.dataset.price);
          return ap - bp;
        }
        if (mode === "new") return (b.dataset.added ?? "").localeCompare(a.dataset.added ?? "");
        return Number(b.dataset.score) - Number(a.dataset.score);
      });
      for (const row of rows) list.append(row);
      rows.forEach((row, index) => {
        const rank = row.querySelector(".rank");
        if (rank instanceof HTMLElement) {
          const place = index + 1;
          rank.textContent = String(place);
          rank.dataset.place = place <= 3 ? String(place) : "rest";
        }
      });
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        for (const other of tabs) other.setAttribute("aria-selected", other === tab ? "true" : "false");
        apply(tab.dataset.sort ?? "score");
      });
    }
  }
</script>
