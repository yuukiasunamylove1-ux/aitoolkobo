---
import Base from "../../layouts/Base.astro";
import { formatScore } from "../../lib/score";
import { absoluteUrl } from "../../lib/labels";
import { categoriesByTheme } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

const description = "バイブコーディング、AIゲーム制作、AIエージェントのカテゴリ一覧です。各カテゴリは公開したスコア順です。";
const site = Astro.site!;
const groups = await categoriesByTheme();
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/categories/", site),
  name: "カテゴリ",
  description,
});
---

<Base title="カテゴリ" description={description} jsonLd={jsonLd}>
  <section class="page-intro">
    <div class="wrap">
      <h1>カテゴリとランキング</h1>
      <p class="lede">
        三つの棚の下にカテゴリがあります。順位は<a href="/scoring/">評価基準</a>の式で計算し、同点は名前の五十音順です。
      </p>
    </div>
  </section>
  {groups.map((group) => (
    <section class="section" id={group.id} aria-labelledby={`theme-${group.id}`}>
      <div class="wrap">
        <h2 id={`theme-${group.id}`}>{group.name}</h2>
        <p>{group.lead}</p>
        <div class="grid-2">
          {group.categories.map(({ category, count, top }) => (
            <article class={`card theme-card theme-${group.id}`}>
              <h3><a href={`/categories/${category.id}/`}>{category.data.name}</a></h3>
              <p>{category.data.description}</p>
              <ul class="meta">
                <li>{count}件</li>
                {top && (
                  <li>
                    1位 {top.tool.data.name} · {formatScore(top.score.total)}
                  </li>
                )}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>
