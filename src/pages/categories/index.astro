---
import Base from "../../layouts/Base.astro";
import { absoluteUrl } from "../../lib/labels";
import { categoriesByTheme } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

const description = "バイブコーディング、AIゲーム制作、AIエージェントのカテゴリです。各カテゴリは公開したスコア順です。";
const site = Astro.site!;
const groups = await categoriesByTheme();
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/categories/", site),
  name: "カテゴリ",
  description,
});
---

<Base title="カテゴリ" description={description} jsonLd={jsonLd}>
  <div class="page">
    <div class="wrap">
      <h1>カテゴリ</h1>
      {groups.map((group) => (
        <section id={group.id} aria-labelledby={`theme-${group.id}`}>
          <h2 id={`theme-${group.id}`}>{group.name}</h2>
          <ul class="guide-list">
            {group.categories.map(({ category, count, top }) => (
              <li>
                <a href={`/categories/${category.id}/`}>{category.data.name}</a>
                <span class="note"> {count}件{top ? ` · 1位 ${top.tool.data.name}` : ""}</span>
                <p class="note">{category.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
