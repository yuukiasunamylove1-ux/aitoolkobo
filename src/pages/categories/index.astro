---
import Base from "../../layouts/Base.astro";
import Shell from "../../components/Shell.astro";
import { absoluteUrl } from "../../lib/labels";
import { categoriesByTheme } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

const description = "バイブコーディング、AIゲーム制作、AIエージェントのカテゴリです。各カテゴリは公開したスコア順です。";
const site = Astro.site!;
const groups = await categoriesByTheme();
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/categories/", site),
  name: "カテゴリ",
  description,
});
---

<Base title="カテゴリ" description={description} jsonLd={jsonLd}>
  <Shell mode="plain">
    <h1>カテゴリ</h1>
    <p class="lede">{description}</p>
    {groups.map((group) => (
      <section id={group.id}>
        <h2>{group.name}</h2>
        <p class="lede">{group.lead}</p>
        <ul class="cat-box">
          {group.categories.map(({ category, count, top }) => (
            <li>
              <a href={`/categories/${category.id}/`}>
                {category.data.name} <span>{count}</span>
              </a>
              <p class="disclaimer">{category.data.description}{top ? ` 1位は「${top.tool.data.name}」。` : ""}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Shell>
</Base>
