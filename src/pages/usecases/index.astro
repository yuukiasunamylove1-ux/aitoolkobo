---
import Base from "../../layouts/Base.astro";
import { absoluteUrl } from "../../lib/labels";
import { usecases } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

const description = "やりたいことからツールを選ぶページです。並びはスコア順ではなく、用途への適合として編集部が並べています。";
const site = Astro.site!;
const items = await usecases();
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/usecases/", site),
  name: "用途別おすすめ",
  description,
});
---

<Base title="用途別おすすめ" description={description} jsonLd={jsonLd}>
  <div class="page">
    <div class="wrap measure">
      <h1>用途別</h1>
      <p class="lede">{description}</p>
      <ol class="guide-list">
        {items.map((item, index) => (
          <li>
            <a href={`/usecases/${item.id}/`}>{index + 1}. {item.data.title}</a>
            <p class="note">{item.data.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>
