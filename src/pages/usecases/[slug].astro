---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { THEMES, absoluteUrl } from "../../lib/labels";
import { pageGraph } from "../../lib/seo";

export async function getStaticPaths() {
  const items = await getCollection("usecases");
  return items.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("usecases", slug);
if (!entry) throw new Error(`unknown usecase ${slug}`);
const { Content } = await render(entry);
const theme = THEMES[entry.data.theme];
const site = Astro.site!;
const url = absoluteUrl(`/usecases/${entry.id}/`, site);

const tools = await Promise.all(
  entry.data.tools.map(async (item) => {
    const tool = await getEntry("tools", item.slug);
    if (!tool) throw new Error(`usecase ${entry.id} missing tool ${item.slug}`);
    return { ...item, tool };
  }),
);

const jsonLd = [
  pageGraph({
    site: site.href,
    url,
    name: entry.data.title,
    description: entry.data.description,
  }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: entry.data.title,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: tools.length,
    itemListElement: tools.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.tool.data.name,
      url: absoluteUrl(`/tools/${item.tool.id}/`, site),
    })),
  },
];
---

<Base title={entry.data.title} description={entry.data.description} jsonLd={jsonLd}>
  <article class="page-intro">
    <div class="wrap prose">
      <Breadcrumb
        items={[
          { name: "ホーム", href: "/" },
          { name: "用途別おすすめ", href: "/usecases/" },
          { name: entry.data.title, href: `/usecases/${entry.id}/` },
        ]}
      />
      <p class="kicker">{theme.name}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="fine">この並びはスコア順ではありません。点数の内訳は各ツールページにあります。</p>
      <ol class="rank-list">
        {tools.map((item, index) => (
          <li class="card">
            <p class="kicker">{index + 1}</p>
            <h2><a href={`/tools/${item.tool.id}/`}>{item.tool.data.name}</a></h2>
            <p>{item.reason}</p>
          </li>
        ))}
      </ol>
      <Content />
    </div>
  </article>
</Base>
