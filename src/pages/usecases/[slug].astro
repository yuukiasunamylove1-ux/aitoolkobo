---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Shell from "../../components/Shell.astro";
import ToolItem from "../../components/ToolItem.astro";
import { priceView } from "../../lib/display";
import { THEMES, absoluteUrl, formatJaDate, latestDate } from "../../lib/labels";
import { rankedTools, usecases } from "../../lib/queries";
import { pageGraph } from "../../lib/seo";

export async function getStaticPaths() {
  const items = await getCollection("usecases");
  return items.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("usecases", slug);
if (!entry) throw new Error(`unknown usecase ${slug}`);
const { Content } = await render(entry);
const site = Astro.site!;
const url = absoluteUrl(`/usecases/${entry.id}/`, site);
const catalog = await rankedTools();
const others = (await usecases()).filter((item) => item.id !== entry.id);

const tools = entry.data.tools.map((item) => {
  const row = catalog.find((candidate) => candidate.tool.id === item.slug);
  if (!row) throw new Error(`usecase ${entry.id} missing tool ${item.slug}`);
  return { ...item, row };
});
const asOf = latestDate(tools.map((item) => item.row.tool.data.lastChecked));

const jsonLd = [
  pageGraph({
    site: site.href,
    url,
    name: entry.data.title,
    description: entry.data.description,
  }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: entry.data.title,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: tools.length,
    itemListElement: tools.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.row.tool.data.name,
      url: absoluteUrl(`/tools/${item.row.tool.id}/`, site),
    })),
  },
];
---

<Base title={entry.data.title} description={entry.data.description} jsonLd={jsonLd}>
  <Shell mode="plain">
    <article class="guide prose">
      <Breadcrumb
        items={[
          { name: "トップ", href: "/" },
          { name: "用途別ガイド", href: "/usecases/" },
          { name: entry.data.title, href: `/usecases/${entry.id}/` },
        ]}
      />
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="tool-meta">
        <span class="badge-cat">{THEMES[entry.data.theme].name}</span>
        {asOf && <> 掲載ツールの確認 {formatJaDate(asOf)}｜AIツール工房編集部</>}
      </p>
      <h2>まずはこの{tools.length}つ</h2>
      <ol class="tool-list">
        {tools.map((item, index) => (
          <ToolItem row={item.row} rank={index + 1} summary={item.reason} showCategory />
        ))}
      </ol>
      <p class="disclaimer">※この並びは総合点順ではありません。用途への向きで編集部が並べています。</p>
      <h2>選び方</h2>
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th>順</th>
              <th>ツール</th>
              <th>理由</th>
              <th>料金</th>
            </tr>
          </thead>
          <tbody>
            {tools.map((item, index) => (
              <tr>
                <td class="num">{index + 1}</td>
                <td><a href={`/tools/${item.row.tool.id}/`}>{item.row.tool.data.name}</a></td>
                <td>{item.reason}</td>
                <td class="num" title={priceView(item.row.tool.data.pricing).title}>{priceView(item.row.tool.data.pricing).text}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Content />
      <h2>関連ガイド</h2>
      <ul class="related">
        {others.map((item) => (
          <li><a href={`/usecases/${item.id}/`}>{item.data.title}</a></li>
        ))}
      </ul>
    </article>
  </Shell>
</Base>
