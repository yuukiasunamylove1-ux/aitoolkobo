---
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import ToolRow from "../components/ToolRow.astro";
import { FX_NOTE } from "../lib/display";
import { THEMES, absoluteUrl } from "../lib/labels";
import { newestTools, rankedTools, usecases } from "../lib/queries";
import { SITE_DESCRIPTION, pageGraph } from "../lib/seo";
import type { ThemeId } from "../lib/schema";

const site = Astro.site!;
const ranked = await rankedTools();
const fresh = await newestTools(10);
const cases = await usecases();
const themes = Object.keys(THEMES) as ThemeId[];
const byTheme = themes.map((theme) => ({
  id: theme,
  name: THEMES[theme].name,
  rows: ranked.filter((row) => row.category.data.theme === theme).slice(0, 10),
}));
const updated = ranked.map((row) => row.tool.data.lastChecked).sort().at(-1) ?? "";
const description = "日本語で作る人のためのAIツール台帳。バイブコーディング、AIゲーム制作、AIエージェントを、スコアと料金で比べます。";
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/", site),
  name: "AIツール工房",
  description: SITE_DESCRIPTION,
});
---

<Base title="AIツール工房" description={description} jsonLd={jsonLd} homeTitle>
  <div class="page">
    <div class="wrap">
      <h1>日本語で作る人のためのAIツール台帳</h1>
      <p class="countline">掲載 {ranked.length}件 · 最終確認 {updated}</p>

      <div class="tabs" data-rank-tabs>
        <div class="tablist" role="tablist" aria-label="今週のランキング">
          {byTheme.map((theme, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${theme.id}`}
              aria-controls={`panel-${theme.id}`}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {theme.name}
            </button>
          ))}
        </div>
        {byTheme.map((theme) => (
          <div role="tabpanel" id={`panel-${theme.id}`} aria-labelledby={`tab-${theme.id}`}>
            <h2 class="panel-title">{theme.name}</h2>
            <ol class="tool-list">
              {theme.rows.map((row, index) => (
                <ToolRow row={row} rank={index + 1} showCategory />
              ))}
            </ol>
          </div>
        ))}
      </div>
      <p class="legend">{FX_NOTE} 日本語の — は未確認です。</p>

      <div class="home-grid">
        <section aria-labelledby="new-heading">
          <div class="head-row">
            <h2 id="new-heading">新着</h2>
            <a href="/new/">すべて見る →</a>
          </div>
          <ol class="tool-list">
            {fresh.map((row) => <ToolRow row={row} showCategory blurb={`${row.tool.data.addedAt} 追加`} />)}
          </ol>
        </section>
        <div>
          <section aria-labelledby="usecase-heading">
            <div class="head-row">
              <h2 id="usecase-heading">用途別</h2>
              <a href="/usecases/">すべて見る →</a>
            </div>
            <ol class="guide-list">
              {cases.map((item, index) => (
                <li>
                  <a href={`/usecases/${item.id}/`}>{index + 1}. {item.data.title}</a>
                </li>
              ))}
            </ol>
          </section>
          <section>
            <h2>評価基準</h2>
            <p class="note">機能、日本語、価格、使いやすさ、更新頻度の重みつきです。確認できない項目は配点から外します。</p>
            <p><a href="/scoring/">算出方法 →</a></p>
          </section>
          <Newsletter />
          <p class="note"><a href="/rss.xml">RSSでも購読できます。</a></p>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector("[data-rank-tabs]");
  if (root instanceof HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const select = (id: string) => {
      for (const tab of tabs) {
        tab.setAttribute("aria-selected", tab.getAttribute("aria-controls") === id ? "true" : "false");
      }
      for (const panel of panels) panel.hidden = panel.id !== id;
      root.classList.add("ready");
    };
    const first = panels[0]?.id;
    if (first) select(first);
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("aria-controls");
        if (id) select(id);
      });
    }
  }
</script>
