---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import ToolItem from "../components/ToolItem.astro";
import ToolLogo from "../components/ToolLogo.astro";
import { THEMES, absoluteUrl } from "../lib/labels";
import { newestTools, rankedTools, usecases } from "../lib/queries";
import { SITE_DESCRIPTION, pageGraph } from "../lib/seo";
import type { ThemeId } from "../lib/schema";

const site = Astro.site!;
const ranked = await rankedTools();
const fresh = await newestTools(8);
const cases = await usecases();
const themes = Object.keys(THEMES) as ThemeId[];
const byTheme = themes.map((theme) => ({
  id: theme,
  name: THEMES[theme].name,
  rows: ranked.filter((row) => row.category.data.theme === theme).slice(0, 5),
}));
const description = "AIツールの比較・ランキング。バイブコーディング、AIゲーム制作、AIエージェントを、公開した総合点と料金で比べます。";
const jsonLd = pageGraph({
  site: site.href,
  url: absoluteUrl("/", site),
  name: "AIツール工房",
  description: SITE_DESCRIPTION,
});
---

<Base title="AIツール工房" description={description} jsonLd={jsonLd} homeTitle>
  <h1 class="visually-hidden">AIツール工房</h1>
  <div class="page">
    <div class="wrap">
      <div class="layout">
        <div>
          <section class="panel" data-rank-tabs>
            <div class="section-head">
              <h2>ジャンル別ランキング</h2>
            </div>
            <div class="box-tabs" role="tablist" aria-label="ジャンル">
              {byTheme.map((theme, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${theme.id}`}
                  aria-controls={`panel-${theme.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {theme.name}
                </button>
              ))}
            </div>
            {byTheme.map((theme) => (
              <div role="tabpanel" id={`panel-${theme.id}`} aria-labelledby={`tab-${theme.id}`}>
                <h3 class="visually-hidden">{theme.name}</h3>
                <ol class="tool-list">
                  {theme.rows.map((row, index) => (
                    <ToolItem row={row} rank={index + 1} showCategory />
                  ))}
                </ol>
                <p><a class="more" href={`/ranking/${theme.id}/`}>{theme.name}のランキングをもっと見る ›</a></p>
              </div>
            ))}
          </section>

          <section class="panel" aria-labelledby="new-heading">
            <div class="section-head">
              <h2 id="new-heading">新着・更新したツール</h2>
              <a class="more" href="/new/">もっと見る ›</a>
            </div>
            <ol class="tool-list">
              {fresh.map((row) => <ToolItem row={row} showCategory posted />)}
            </ol>
          </section>

          <section class="panel" aria-labelledby="usecase-heading">
            <div class="section-head">
              <h2 id="usecase-heading">用途別ガイド</h2>
              <a class="more" href="/usecases/">もっと見る ›</a>
            </div>
            <div class="guide-grid">
              {cases.map((item) => (
                <a class="guide-card" href={`/usecases/${item.id}/`}>
                  <span class="logo-stack">
                    {item.data.tools.slice(0, 3).map((tool) => {
                      const row = ranked.find((candidate) => candidate.tool.id === tool.slug);
                      return row ? <ToolLogo slug={row.tool.id} name={row.tool.data.name} size={32} /> : null;
                    })}
                  </span>
                  <span>
                    <strong>「{item.data.title}」</strong>
                    <p>{item.data.description}</p>
                  </span>
                </a>
              ))}
            </div>
          </section>
        </div>
        <Sidebar mode="home" />
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector("[data-rank-tabs]");
  if (root instanceof HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const select = (id: string) => {
      for (const tab of tabs) {
        tab.setAttribute("aria-selected", tab.getAttribute("aria-controls") === id ? "true" : "false");
      }
      for (const panel of panels) panel.hidden = panel.id !== id;
    };
    const first = panels[0]?.id;
    if (first) select(first);
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("aria-controls");
        if (id) select(id);
      });
    }
  }
</script>
