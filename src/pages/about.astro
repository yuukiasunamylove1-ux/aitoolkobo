---
import Base from "../layouts/Base.astro";
import { FX_NOTE } from "../lib/display";
import { absoluteUrl } from "../lib/labels";
import { pageGraph } from "../lib/seo";

const description = "AIツール工房の運営方針です。編集部が公開データと定性評価でディレクトリを更新します。";
const faqs = [
  {
    q: "どんなツールを載せていますか？",
    a: "日本語でアプリやゲームを作る人向けに、バイブコーディング、AIゲーム制作、AIエージェントの三つへ絞っています。",
  },
  {
    q: "一覧の — は何ですか？",
    a: "未確認です。日本語対応や料金を確認できていない項目は、推測で埋めずに — と書きます。",
  },
  {
    q: "円の「約」は公式価格ですか？",
    a: FX_NOTE,
  },
  {
    q: "スコアは誰が付けていますか？",
    a: "機能・使いやすさ・更新頻度は編集部の定性評価です。日本語と価格は公開データから式で計算し、未確認の項目は配点から外します。式は評価基準ページにあります。",
  },
];
const jsonLd = [
  pageGraph({
    site: Astro.site!.href,
    url: absoluteUrl("/about/", Astro.site!),
    name: "運営者情報",
    description,
  }),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<Base title="運営者情報" description={description} jsonLd={jsonLd}>
  <article class="page">
    <div class="wrap prose measure">
      <h1>運営者情報</h1>
      <p>
        AIツール工房（aitoolkobo）は、日本語でアプリやゲームを作る人向けのディレクトリです。個人開発者と小規模チームが、道具を短時間で比べられることを目的にしています。
      </p>
      <h2>編集方針</h2>
      <ul>
        <li>対象はバイブコーディング、AIゲーム制作、AIエージェントです。</li>
        <li>公式の円建てが確認できない料金は — と書きます。米ドルの月額が分かるときだけ、表示用の概算円を併記します。</li>
        <li>日本語対応は UI・入力・出力に分け、確認できない段は —（未確認）にします。</li>
        <li>順位は<a href="/scoring/">評価基準</a>の式だけに従います。</li>
        <li>ツールの追加日は、このディレクトリへ載せた日です。</li>
      </ul>
      <h2>よくある質問</h2>
      {faqs.map((faq) => (
        <section>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </section>
      ))}
      <h2>運営</h2>
      <p>
        運営者の氏名・住所の公開は準備中です。連絡は<a href="/contact/">お問い合わせ</a>の案内に従ってください。お問い合わせフォームは、まだ送信先に接続していません。
      </p>
    </div>
  </article>
</Base>
