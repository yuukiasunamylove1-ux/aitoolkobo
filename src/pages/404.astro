---
import Base from "../layouts/Base.astro";
import Shell from "../components/Shell.astro";

const description = "ページが見つかりません。カテゴリ一覧から探せます。";
---

<Base title="ページが見つかりません" description={description}>
  <Shell mode="plain">
    <section>
      <h1>ページが見つかりません</h1>
      <p class="lede">アドレスが変わったか、まだ無いページです。</p>
      <div class="actions">
        <a class="button" href="/">ホームへ戻る</a>
        <a class="button secondary" href="/categories/">カテゴリを見る</a>
      </div>
    </section>
  </Shell>
</Base>
