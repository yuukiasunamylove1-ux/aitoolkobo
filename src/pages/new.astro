---
import Base from "../layouts/Base.astro";
import Shell from "../components/Shell.astro";
import ToolLogo from "../components/ToolLogo.astro";
import { absoluteUrl, formatJaDate, formatJaMonthDay } from "../lib/labels";
import { newestTools } from "../lib/queries";
import { formatScore } from "../lib/score";
import { pageGraph } from "../lib/seo";
import { THEMES } from "../lib/labels";

const description = "ディレクトリへ新しく追加したAIツールです。日付は製品の発売日ではなく、このサイトへの追加日です。";
const site = Astro.site!;
const tools = await newestTools();
const groups: { date: string; rows: typeof tools }[] = [];
for (const row of tools) {
  const date = row.tool.data.addedAt;
  const last = groups.at(-1);
  if (last && last.date === date) last.rows.push(row);
  else groups.push({ date, rows: [row] });
}
const jsonLd = [
  pageGraph({
    site: site.href,
    url: absoluteUrl("/new/", site),
    name: "新着AIツール",
    description,
  }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "新着AIツール",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: tools.length,
    itemListElement: tools.map((row, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: row.tool.data.name,
      url: absoluteUrl(`/tools/${row.tool.id}/`, site),
    })),
  },
];
---

<Base title="新着AIツール" description={description} jsonLd={jsonLd}>
  <Shell mode="plain">
    <div class="section-head">
      <h1 id="new-page">新着・更新情報</h1>
      <a class="more" href="/rss.xml">RSS ›</a>
    </div>
    <p class="disclaimer">※日付はこのサイトへ掲載した日です。製品の発売日ではありません。</p>
    {groups.map((group) => (
      <section>
        <h2 class="news-day">{formatJaMonthDay(group.date)}</h2>
        {group.rows.map((row) => (
          <article class="news-item">
            <div>
              <p class="news-kicker">
                <span class="news-date">{formatJaDate(row.tool.data.addedAt)}</span>
                {" "}
                <span class="badge-cat">{THEMES[row.category.data.theme].name}</span>
              </p>
              <a class="news-title" href={`/tools/${row.tool.id}/`}>「{row.tool.data.name}」を掲載しました</a>
              <p class="news-meta">{row.category.data.name}｜総合 {formatScore(row.score.total)}点</p>
            </div>
            <a class="logo-frame" href={`/tools/${row.tool.id}/`} tabindex="-1" aria-hidden="true">
              <ToolLogo slug={row.tool.id} name={row.tool.data.name} size={48} />
            </a>
          </article>
        ))}
      </section>
    ))}
  </Shell>
</Base>
