---
import Base from "../layouts/Base.astro";
import ToolRow from "../components/ToolRow.astro";
import { absoluteUrl, formatDate } from "../lib/labels";
import { newestTools } from "../lib/queries";
import { pageGraph } from "../lib/seo";

const description = "ディレクトリへ新しく追加したAIツールです。日付は製品の発売日ではなく、このサイトへの追加日です。";
const site = Astro.site!;
const tools = await newestTools();
const jsonLd = [
  pageGraph({
    site: site.href,
    url: absoluteUrl("/new/", site),
    name: "新着AIツール",
    description,
  }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "新着AIツール",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: tools.length,
    itemListElement: tools.map((row, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: row.tool.data.name,
      url: absoluteUrl(`/tools/${row.tool.id}/`, site),
    })),
  },
];
---

<Base title="新着AIツール" description={description} jsonLd={jsonLd}>
  <div class="page">
    <div class="wrap">
      <h1>新着</h1>
      <p class="lede">{description} <a href="/rss.xml">RSS</a></p>
      <ol class="tool-list">
        {tools.map((row) => (
          <ToolRow row={row} showCategory blurb={formatDate(row.tool.data.addedAt)} />
        ))}
      </ol>
    </div>
  </div>
</Base>
