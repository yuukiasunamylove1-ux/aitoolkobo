---
import { absoluteUrl } from "../lib/labels";

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const site = Astro.site!;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: absoluteUrl(item.href, site),
  })),
};
---

<nav aria-label="パンくず">
  <ol class="breadcrumb">
    {items.map((item, index) => (
      <li>
        {index > 0 && <span aria-hidden="true"> / </span>}
        {index === items.length - 1 ? item.name : <a href={item.href}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
