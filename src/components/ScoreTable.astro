---
import { formatScore, type ScoreBreakdown } from "../lib/score";

interface Props {
  score: ScoreBreakdown;
}
const { score } = Astro.props;
const format = (value: number) => value.toFixed(1);
---

<div>
  <p class="fine">
    100点満点。確認できない項目（合計 {score.excludedWeight}%）は外し、残りの重みを100%に割り戻しています。表の — は未確認です。式は<a href="/scoring/">評価基準</a>と同じです。
  </p>
  <div class="table-scroll">
  <table class="data">
    <caption>スコア内訳 {formatScore(score.total)}</caption>
    <thead>
      <tr>
        <th>項目</th>
        <th>素点</th>
        <th>設定の重み</th>
        <th>有効な重み</th>
        <th>寄与</th>
      </tr>
    </thead>
    <tbody>
      {score.rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td class="num" title={row.raw == null ? "未確認" : undefined}>{row.raw == null ? "—" : `${row.raw} / 5`}</td>
          <td class="num">{row.weight}%</td>
          <td class="num">{row.included ? `${format(row.effectiveWeight)}%` : "—"}</td>
          <td class="num">{row.included ? format(row.contribution) : "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
</div>
