---
import { formatScore, type ScoreBreakdown } from "../lib/score";

interface Props {
  score: ScoreBreakdown;
}
const { score } = Astro.props;
const format = (value: number) => value.toFixed(1);
---

<div class="table-scroll">
  <table class="data">
    <caption class="visually-hidden">評価の内訳 {formatScore(score.total)}点</caption>
    <thead>
      <tr>
        <th>項目</th>
        <th>評価（5段階）</th>
        <th>重み</th>
        <th>点数</th>
      </tr>
    </thead>
    <tbody>
      {score.rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td class="num">{row.raw == null ? "未確認" : `${row.raw}`}</td>
          <td class="num">{row.weight}%</td>
          <td class="num">{row.included ? format(row.contribution) : "未確認"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="disclaimer">
  ※確認できない項目（合計 {score.excludedWeight}%）は配点から外しています。
  <a href="/scoring/">評価基準 ›</a>
</p>
