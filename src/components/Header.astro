---
import { formatJaDateLong, latestDate } from "../lib/labels";
import { rankedTools } from "../lib/queries";

const path = Astro.url.pathname;
const q = Astro.url.searchParams.get("q") ?? "";
const ranked = await rankedTools();
const updated = latestDate(ranked.map((row) => row.tool.data.lastChecked));

const links = [
  { href: "/", label: "トップ", current: path === "/" },
  { href: "/ranking/vibe/", label: "バイブコーディング", current: path.startsWith("/ranking/vibe") },
  { href: "/ranking/game/", label: "AIゲーム制作", current: path.startsWith("/ranking/game") },
  { href: "/ranking/agent/", label: "AIエージェント", current: path.startsWith("/ranking/agent") },
  { href: "/ranking/", label: "ランキング", current: path === "/ranking/" },
  { href: "/new/", label: "新着", current: path.startsWith("/new") },
  { href: "/usecases/", label: "用途別ガイド", current: path.startsWith("/usecases") },
  { href: "/scoring/", label: "評価基準", current: path.startsWith("/scoring") },
];
---

<div class="brand-rule"></div>
<header class="site-header">
  <div class="wrap head-main">
    <a class="brand" href="/">
      <img src="/favicon.svg" width="32" height="32" alt="" />
      <span>
        <span class="brand-name">AIツール工房</span>
        <span class="brand-sub">AIツールの比較・ランキング</span>
      </span>
    </a>
    <form class="search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">ツール名で検索</label>
      <input id="site-search" name="q" type="search" placeholder="ツール名で検索" value={q} />
      <button type="submit">検索</button>
    </form>
  </div>
  <div class="catband">
    <nav class="wrap catband-inner" aria-label="主要">
      {links.map((link) => (
        <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="updateband">
    <p class="wrap">AIツール工房 {formatJaDateLong(updated)} 更新｜掲載 {ranked.length}ツール</p>
  </div>
</header>
