---
import { SUPPORT_LABEL, TIER_LABEL, formatDate } from "../lib/labels";
import { formatScore } from "../lib/score";
import type { RankedTool } from "../lib/queries";

interface Props {
  row: RankedTool;
  rank?: number;
  marker?: string;
  markerNote?: string;
}
const { row, rank, marker, markerNote } = Astro.props;
const { tool, category, score } = row;
const yen = tool.data.pricing.yenAmount;
---

<article class="card rank-row">
  <p class="rank-no">
    {marker ?? String(rank).padStart(2, "0")}
    <span>{markerNote ?? `${rank}位`}</span>
  </p>
  <div>
    <h2>
      <a href={`/tools/${tool.id}/`}>{tool.data.name}</a>
    </h2>
    <p>{tool.data.description}</p>
    <ul class="meta">
      <li>スコア <span class="score">{formatScore(score.total)}</span></li>
      <li>{TIER_LABEL[tool.data.pricing.tier]}</li>
      <li>{tool.data.pricing.short}</li>
      <li>円建て {yen == null ? "未確認" : `¥${yen.toLocaleString("ja-JP")}`}</li>
      <li>日本語UI {SUPPORT_LABEL[tool.data.japanese.ui]}</li>
      {marker && <li>追加 {formatDate(tool.data.addedAt)}</li>}
      <li><a href={`/categories/${category.id}/`}>{category.data.name}</a></li>
    </ul>
  </div>
</article>
