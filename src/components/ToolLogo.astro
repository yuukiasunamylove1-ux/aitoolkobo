---
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  slug: string;
  name: string;
  size?: number;
}
const { slug, name, size = 24 } = Astro.props;
const png = join(process.cwd(), "public", "logos", `${slug}.png`);
const ico = join(process.cwd(), "public", "logos", `${slug}.ico`);
const src = existsSync(png) ? `/logos/${slug}.png` : existsSync(ico) ? `/logos/${slug}.ico` : null;
const letter = name.trim().charAt(0).toUpperCase();
---

{
  src ? (
    <img class="logo" src={src} width={size} height={size} alt="" />
  ) : (
    <span class="monogram" style={`width:${size}px;height:${size}px`} aria-hidden="true">{letter}</span>
  )
}
